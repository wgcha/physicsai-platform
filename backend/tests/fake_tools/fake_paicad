CATEGORY = {"GEOM_CAD_FAILED": "CAD_FAILED", "GEOM_TOPOLOGY_CHANGED": "CAD_FAILED", "GEOM_FEATURE_COLLISION": "CAD_FAILED",
            "GEOM_INTERFERENCE": "INTERFERENCE", "GEOM_QUALITY": "QUALITY", "GEOM_MORPH_FAILED": "QUALITY", "GEOM_DEVIATION": "DEVIATION",
            "GEOM_PARAM_MISMATCH": "DEVIATION", "GEOM_TIE_PROJECTION": "TIE", "GEOM_BODY_MAP_FAILED": "PREP",
            "GEOM_BASELINE_MISMATCH": "PREP", "GEOM_UNSUPPORTED_ELEMENT": "PREP", "GEOM_TAG_FAILED": "PREP",
            "GEOM_EXTRACT_EMPTY": "PREP", "GEOM_INPUT_INVALID": "INPUT", "GEOM_OUTPUT_EXISTS": "INPUT", "RENUM_CSV_MISSING": "INPUT",
            "GEOM_INTERNAL": "INTERNAL", "PROP_OVERRIDDEN_BY_ELEMENT": "PROP", "PROP_OVERRIDDEN_BY_PART": "PROP",
            "PROP_THICKNESS_INVALID": "PROP", "PROP_NOT_FOUND": "INPUT", "PARAM_NAME_CONFLICT": "INPUT",
            "SHELL_FIXED_REGION_VIOLATION": "FIXED", "SHELL_FIXED_PARSE_FAILED": "PREP", "SHELL_UNSUPPORTED_ELEMENT": "PREP",
            "SHELL_BODY_NOT_SHEET": "PREP", "SHELL_PART_NOT_FOUND": "INPUT", "VIEW_TESSELLATION_FAILED": "VIEW", "VIEW_TOO_LARGE": "VIEW"}
