    runj = os.path.join(args["check-dir"], "run.json")
    steps = {}
    result = ("OK", None, 0)
    for name, fn in (("update", lambda: step_update(args["update-dir"], None, "update")),
                     ("morph", lambda: step_morph(args["morph-dir"], args["update-dir"])),
                     ("check", lambda: step_check(args["check-dir"], args["update-dir"], args["morph-dir"]))):
        progress({"update": 20, "morph": 60, "check": 90}[name], f"run {name}")
        rc, code = fn()
        steps[name] = {"status": "FAIL" if code else "OK", "code": code}
        if code:
            result = ("FAIL", code, rc)
            break
    os.makedirs(args["check-dir"], exist_ok=True)
    stat = "FAIL" if result[0] == "FAIL" else "PASS"
    write_json(runj, dict(BASE, status=stat, code=result[1], category=CATEGORY.get(result[1] or "", None), stages=steps,
