#!/usr/bin/env python3
"""가짜 qstat: 호출 횟수에 따라 Q → R → F(+Exit_status)."""
import json, os, sys, tempfile

m = os.environ.get("FAKE_TOOL_MODE_PBS") or "ok"
state = os.environ.get("FAKE_PBS_STATE") or os.path.join(tempfile.gettempdir(), "fake_pbs_state.json")
st = json.load(open(state)) if os.path.exists(state) else {"polls": 0}
st["polls"] = st.get("polls", 0) + 1
json.dump(st, open(state, "w"))
if m == "not_found":
    print(f"qstat: Unknown Job Id {sys.argv[-1]}", file=sys.stderr)
    sys.exit(153)
if m == "unknown":
    print("garbage output")
    sys.exit(0)
n = st["polls"]
s = "Q" if n == 1 else ("R" if n == 2 else "F")
print(f"Job Id: {sys.argv[-1]}\n    job_state = {s}")
if s == "F":
    print(f"    Exit_status = {1 if m == 'exit1' else 0}")
