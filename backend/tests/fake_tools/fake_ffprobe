#!/usr/bin/env python3
"""가짜 ffprobe(phase3 §21.4.3 S16). 마지막 인자 = 영상 파일. 출력 `codec_name=…`·`pix_fmt=…`
(FAKE_FFPROBE_CODEC 기본 h264, FAKE_FFPROBE_PIXFMT 기본 yuv420p). FAKE_TOOL_MODE_FFPROBE=fail → 종료코드 1."""
import json, os, sys

rec = os.environ.get("FAKE_TOOL_RECORD")
if rec:
    with open(rec, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({"tool": "ffprobe", "argv": sys.argv, "cwd": os.getcwd()}, ensure_ascii=False) + "\n")
if (os.environ.get("FAKE_TOOL_MODE_FFPROBE") or "") == "fail" or not os.path.isfile(sys.argv[-1]):
    print("fake ffprobe: invalid data", file=sys.stderr)
    sys.exit(1)
print("codec_name=" + (os.environ.get("FAKE_FFPROBE_CODEC") or "h264"))
print("pix_fmt=" + (os.environ.get("FAKE_FFPROBE_PIXFMT") or "yuv420p"))
