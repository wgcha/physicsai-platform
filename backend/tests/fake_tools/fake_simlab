#!/usr/bin/env python3
"""가짜 SimLab.bat(§18.1, phase2 §16.1).

- 형상 갱신(phase3 §11.4, V3-S6-14): -auto SCRIPT -nographics → 렌더 스크립트의 dir_file_export(없으면 EPS_mesh_0000.rad)를
  cwd에 작성(원본 tpl:110). 스크립트의 dir_file_prt(원본 tpl:19, 상대경로는 cwd 기준)가 없으면 종료코드 2
- 파라미터 추출(2차): -auto L CAD XML -nographics → <L stem>_LogFile.txt에 Passed 4줄, XML
  L과 같은 폴더에 get_parameter_from_cad_core*.pyd가 없으면 종료코드 4
모드(FAKE_TOOL_MODE_SIMLAB > FAKE_TOOL_MODE): ok | fail | hang | no_output | bad_xml
  | nonzero_with_output(형상 갱신 출력을 쓰고 종료코드 3) | with_include(형상 갱신 때 include도 직접 작성 — mesh null 변형,
  이름 FAKE_SIMLAB_INCLUDE, 기본 104_replace_node_elem.inc)
동시 실행(phase3 §14.5 BP_GEN): 실행마다 cwd에만 쓰므로 동시 실행 OK. FAKE_TOOL_TRACE(jsonl)에 시작·끝 시각(time.time)·pid를 남겨
관측 동시 수를 셀 수 있다. FAKE_SIMLAB_SLEEP_S = 형상 갱신 전 대기(겹침 관측용), FAKE_SIMLAB_FAIL_MATCH = cwd에 이 문자열이
들어 있으면 그 실행만 종료코드 1(run 실패 격리 시험).
형상 갱신 입력 확인(altair-vars.md V-AV-3): FAKE_SIMLAB_PARAMITEMS=<jsonl> → 렌더 스크립트의 paramitem(Name → NewValue 문자열)을 cwd와 함께 남기고,
NewValue에 치환되지 않은 변수 참조 `{`가 있으면 종료코드 5(전체 tpl의 모든 파라미터에 값이 들어갔는지 확인).
동시 실행 하한(phase3 §23.11 S18): FAKE_SIMLAB_BARRIER=<폴더>:<n> → 형상 갱신 실행마다 <폴더>/<pid>를 만들고 파일이 n개 이상이 될
때까지 기다린다(순차 실행이면 풀리지 않음). FAKE_SIMLAB_BARRIER_TIMEOUT_S(기본 90)를 넘으면 "barrier timeout" 출력 후 종료코드 9.
"""
import atexit, glob, json, os, re, subprocess, sys, time

m = os.environ.get("FAKE_TOOL_MODE_SIMLAB") or os.environ.get("FAKE_TOOL_MODE") or "ok"
p = os.environ.get("FAKE_TOOL_RECORD")
if p:
    with open(p, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({"tool": "simlab", "argv": sys.argv, "cwd": os.getcwd()}) + "\n")
_trace = os.environ.get("FAKE_TOOL_TRACE")
if _trace:
    def _ev(ev):
        with open(_trace, "a", encoding="utf-8") as fh:
            fh.write(json.dumps({"tool": "simlab", "ev": ev, "pid": os.getpid(), "t": time.time(), "cwd": os.getcwd()}) + "\n")
    _ev("start")
    atexit.register(_ev, "end")
_fm = os.environ.get("FAKE_SIMLAB_FAIL_MATCH")
if _fm and _fm in os.getcwd():
    print(f"SimLab (fake) failure for {os.getcwd()}", flush=True)
    sys.exit(1)
_bar = os.environ.get("FAKE_SIMLAB_BARRIER")
if _bar and "-auto" in sys.argv and len(sys.argv) != 6:
    _bdir, _, _bn = _bar.rpartition(":")
    os.makedirs(_bdir, exist_ok=True)
    open(os.path.join(_bdir, str(os.getpid())), "w").close()
    _deadline = time.time() + float(os.environ.get("FAKE_SIMLAB_BARRIER_TIMEOUT_S", "90") or 90)
    while len(os.listdir(_bdir)) < int(_bn):
        if time.time() > _deadline:
            print("barrier timeout", flush=True)
            sys.exit(9)
        time.sleep(0.05)
if float(os.environ.get("FAKE_SIMLAB_SLEEP_S", "0") or 0) and "-auto" in sys.argv and len(sys.argv) != 6:
    time.sleep(float(os.environ["FAKE_SIMLAB_SLEEP_S"]))
if m == "fail":
    sys.exit(1)
if m == "hang":
    child = subprocess.Popen([sys.executable, "-c", "import time\nwhile True: time.sleep(1)"])
    pf = os.environ.get("FAKE_TOOL_PIDFILE")
    if pf:
        open(pf, "w").write(f"{os.getpid()} {child.pid}\n")
    if _trace:  # 동시 실행 취소 시험: 프로세스 트리(자신·손자) pid를 모두 남긴다
        with open(_trace, "a", encoding="utf-8") as fh:
            fh.write(json.dumps({"tool": "simlab", "ev": "hang", "pid": os.getpid(), "child": child.pid, "t": time.time()}) + "\n")
    while True:
        time.sleep(0.2)
a = sys.argv
script = a[a.index("-auto") + 1]
if not os.path.isfile(script):
    print(f"script not found: {script}", flush=True)
    sys.exit(2)
if len(a) == 6:  # 파라미터 추출: -auto L CAD XML -nographics
    cad, xml = a[3], a[4]
    if not os.path.isfile(cad):
        print(f"cad not found: {cad}", flush=True)
        sys.exit(2)
    if not glob.glob(os.path.join(os.path.dirname(script), "get_parameter_from_cad_core*.pyd")):
        print("ImportError: get_parameter_from_cad_core", flush=True)
        sys.exit(4)
    logf = os.path.join(os.path.dirname(script), os.path.splitext(os.path.basename(script))[0] + "_LogFile.txt")
    with open(logf, "a", encoding="utf-8") as fh:
        for i in range(4):
            fh.write(f"step {i + 1} Passed\n")
            fh.flush()
            time.sleep(float(os.environ.get("FAKE_SIMLAB_STEP_S", "0.2")))
    if m == "no_output":
        print("SimLab (fake) extract done without xml", flush=True)
        sys.exit(0)
    body = ("<Root><Model><Parameter><Name>THK_1</Name><Value>3 mm</Value></Parameter>"
            "<Parameter><Name>RIB_H</Name><Value>12.5</Value></Parameter>"
            "<Parameter><Name>bad name</Name><Value>x</Value></Parameter></Model></Root>")
    if m == "bad_xml":
        body = '<?xml version="1.0"?><!DOCTYPE r [<!ENTITY x "y">]>' + body
    with open(xml, "w", encoding="utf-8") as fh:
        fh.write(body)
    print("SimLab (fake) parameters extracted", flush=True)
    sys.exit(0)
# 형상 갱신·메싱·내보내기 1회(원본 tpl:43-169)
with open(script, encoding="utf-8-sig") as fh:
    body = fh.read()
_pi = os.environ.get("FAKE_SIMLAB_PARAMITEMS")
if _pi:
    items = dict(re.findall(r'<paramitem\s+Name="([^"]*)"\s+NewValue="([^"]*)"', body))
    with open(_pi, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({"cwd": os.getcwd(), "paramitems": items}) + "\n")
    if any("{" in v for v in items.values()):
        print("unreplaced paramitem value", flush=True)
        sys.exit(5)
mexp = re.search(r'dir_file_export\s*=\s*r?"([^"]*)"', body)
export = mexp.group(1) if mexp else "EPS_mesh_0000.rad"
mprt = re.search(r'dir_file_prt\s*=\s*r?"([^"]*)"', body)
if mprt and not os.path.isfile(mprt.group(1)):
    print(f"CAD not found: {mprt.group(1)} (cwd {os.getcwd()})", flush=True)
    sys.exit(2)
if m == "no_output":
    print("SimLab (fake) finished without export", flush=True)
    sys.exit(0)
with open(export, "w") as fh:
    fh.write("#RADIOSS STARTER\n/NODE\n1 0 0 0\n2 1 0 0\n/SHELL/1\n1 1 2 2 1\n")
if m == "with_include":
    with open(os.environ.get("FAKE_SIMLAB_INCLUDE") or "104_replace_node_elem.inc", "w") as fh:
        fh.write("/NODE\n3000001 0 0 0\n")
print("Complete export", flush=True)
if m == "nonzero_with_output":
    sys.exit(3)
