#!/usr/bin/env python3
"""가짜 edspy.bat(§18.1)."""
import json, os, subprocess, sys, time

NAME = "EDSPY"


def record():
    p = os.environ.get("FAKE_TOOL_RECORD")
    if p:
        with open(p, "a", encoding="utf-8") as fh:
            fh.write(json.dumps({"tool": "edspy", "argv": sys.argv, "cwd": os.getcwd(),
                                 "env": {k: os.environ.get(k) for k in ("EDS_TNS_ACTVN_CHCKPT",)},
                                 "env_keys": sorted(os.environ)}) + "\n")


def mode():
    return os.environ.get(f"FAKE_TOOL_MODE_{NAME}") or os.environ.get("FAKE_TOOL_MODE") or "ok"


def arg(flag):
    a = sys.argv
    return a[a.index(flag) + 1] if flag in a and a.index(flag) + 1 < len(a) else None


def hang():
    child = subprocess.Popen([sys.executable, "-c", "import time\nwhile True: time.sleep(1)"])
    pf = os.environ.get("FAKE_TOOL_PIDFILE")
    if pf:
        with open(pf, "w") as fh:
            fh.write(f"{os.getpid()} {child.pid}\n")
    print("hang: waiting for cancel", flush=True)
    while True:
        time.sleep(0.2)


def main():
    record()
    m = mode()
    d = float(os.environ.get("FAKE_TOOL_DELAY_S", "0") or 0)
    if d:
        time.sleep(d)
    print("Altair edspy (fake) starting", flush=True)
    if m == "hang":
        hang()
    if m == "fail":
        print("fatal: fake failure", flush=True)
        return 1
    if "--probe-echo" in sys.argv:  # 환경 점검 프로브 시험: 긴 출력 + 비밀 문자열
        for i in range(5000):
            print(f"filler line {i:05d} " + "x" * 40)
        print("db " + os.environ.get("FAKE_ECHO", ""), flush=True)
        return 0
    if "--create-dataset" in sys.argv:
        out, spec = arg("--create-dataset"), arg("--spec")
        with open(spec, encoding="utf-8") as fh:
            files = [l[2:].strip() for l in fh if l.startswith("- ")]
        missing = [f for f in files if not os.path.isfile(f)]
        if missing:
            print(f"[ERROR] missing file {missing[0]}", flush=True)
            return 2
        print(f"processing {len(files)} files", flush=True)
        if m != "no_output":
            size = 1024 if m == "small" else 1024 * 1024 + 1
            with open(out, "wb") as fh:
                fh.write(b"\0" * size)
    elif "--score" in sys.argv:
        s = arg("--score")
        if not os.path.isfile(arg("--model")) or not os.path.isfile(arg("--dataset")):
            print("[ERROR] model/dataset missing", flush=True)
            return 2
        if m != "no_output":
            with open(s, "w") as fh:
                fh.write("score\n")
            with open(os.path.join(os.path.dirname(s), "predictions.psdata"), "wb") as fh:
                fh.write(b"\0" * 10)
        print("R2 = 0.93", flush=True)
        print("MAE = 1.25", flush=True)
    elif "--predict-write" in sys.argv:
        if os.environ.get("EDS_TNS_ACTVN_CHCKPT") != "1":
            print("EDS_TNS_ACTVN_CHCKPT not set", flush=True)
            return 3
        h = arg("--predict-write")
        if not os.path.isfile(arg("--input-file")) or not os.path.isfile(arg("--model")):
            print("[ERROR] input missing", flush=True)
            return 2
        if m != "no_output":
            os.makedirs(os.path.dirname(h), exist_ok=True)
            with open(h, "wb") as fh:
                fh.write(b"H3DPRED")
            if m != "noxy":
                stem = os.path.splitext(os.path.basename(h))[0]
                with open(os.path.join(os.path.dirname(h), stem + ".xy"), "w") as fh:
                    fh.write("XYDATA, Impact_force\n0.0 0.0\n0.1 10.5\n0.2 20.25\n0.3 15.0\n")
    else:
        print("unknown command", flush=True)
        return 4
    if m == "error_log":
        print("Traceback (most recent call last):", flush=True)
        print('  File "x.py", line 1', flush=True)
    print("done", flush=True)
    return 0


sys.exit(main())
