#!/usr/bin/env python3
"""가짜 hw.exe(§18.1, phase2 §16.1).

- 1차 컨투어: -clientconfig hwpost.dat -b -tcl X -input H -output J → J = 원본 미리보기 TCL 형식(phase3 §11.1)
  {h3d, num_time_step, subcases:[{id, label, datatypes:[{name, format, binding, components, layers}]}]}
- ④ MESH(원본 m_2, phase3 §11.4·V3-S6-14): -clientconfig hwfepre.dat -b -tcl X A B C → A(SimLab 메시) 확인 후 B(include)와
  cwd log_batch.txt("COMPLETE HM BATCHRUN") 작성. 모드 FAKE_TOOL_MODE_HM(> FAKE_TOOL_MODE_HW > FAKE_TOOL_MODE):
  ok | fail(종료코드 1, 출력 없음) | no_output(종료코드 0, include 없음) | no_marker(로그에 표식 없음) | nonzero_with_output(종료코드 3)
- response_extract 예시: --responses J --input H --out C
- ④ 응답 추출 원본 ⑤ m_4(phase3 §14.6, V3-S9-16): -clientconfig hwpost.dat -b -tcl X(X가 마지막 인자) → X 폴더의 H3D_REQUESTS.txt
  (`#` 줄 무시, NAME|SUBCASE|DATATYPE|COMPONENT|LAYER)와 *_pred.h3d(없으면 *.h3d)를 읽어 같은 폴더에 RESPONSES.txt·RESPONSES.log.
  값(결정적): i번째 요청 MIN = -(1.5 + i), MAX = 100 + 10·i (+ h3d 바이트 수 % 7). 모드 FAKE_TOOL_MODE_HWRESP(> FAKE_TOOL_MODE_HW >
  FAKE_TOOL_MODE): minmax(=ok) | fail(종료코드 1, 출력 없음) | nonzero_with_output(종료코드 4) | no_h3d(전부 OPEN_ERROR).
  FAKE_HW_NO_VALUE=이름1,이름2 → 그 요청은 `RESP:<NAME>=NO_VALUE`
- ②-1 h3d 미리보기: -b -tcl X -h3d H -result J
- ②-3 T01 미리보기: -b -c -tcl X -input T -output J
- ②-4 곡선 추출: -b -c -tcl X -config C (jobs마다 outputFile)
모드(FAKE_TOOL_MODE_HW > FAKE_TOOL_MODE): ok | fail | skip_one(곡선 첫 job 출력 없음) | no_output | error_log
"""
import base64, json, os, sys
if any(os.path.basename(x) == "contour_extract.tcl" for x in sys.argv[1:]):  # geometry-view.md §13 결과 3D 컨투어 추출
    sys.path.insert(0, os.path.dirname(os.path.abspath(sys.argv[0]))); import fake_hw_capture; sys.exit(fake_hw_capture.main_extract(sys.argv))  # noqa: E401,E702
if any(os.path.basename(x) == "contour_capture.tcl" for x in sys.argv[1:]):  # phase3 §15 S10 컨투어 캡처 → fake_hw_capture.py
    sys.path.insert(0, os.path.dirname(os.path.abspath(sys.argv[0]))); import fake_hw_capture; sys.exit(fake_hw_capture.main(sys.argv))  # noqa: E401,E702

m = os.environ.get("FAKE_TOOL_MODE_HW") or os.environ.get("FAKE_TOOL_MODE") or "ok"
p = os.environ.get("FAKE_TOOL_RECORD")
if p:
    with open(p, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({"tool": "hw", "argv": sys.argv, "cwd": os.getcwd()}) + "\n")
_trace = os.environ.get("FAKE_TOOL_TRACE")
if _trace:
    import atexit, time

    def _ev(ev):
        with open(_trace, "a", encoding="utf-8") as fh:
            fh.write(json.dumps({"tool": "hw", "ev": ev, "pid": os.getpid(), "t": time.time(), "cwd": os.getcwd()}) + "\n")
    _ev("start")
    atexit.register(_ev, "end")
if "hwfepre.dat" in sys.argv:  # HyperMesh 배치: include 변환 TCL(원본 BATCHRUN_create_include_node_elem.tcl)
    hm = os.environ.get("FAKE_TOOL_MODE_HM") or m
    a = sys.argv
    tcl, mesh_in, inc_out, csv = a[a.index("-tcl") + 1: a.index("-tcl") + 5]
    if hm == "fail":
        sys.exit(1)
    if not os.path.isfile(tcl) or not os.path.isfile(mesh_in):
        print(f"input not found: {tcl} {mesh_in}", flush=True)
        sys.exit(2)
    log = ["hw (fake) HyperMesh batch", f"read {mesh_in}", f"renum csv {'found' if os.path.isfile(csv) else 'missing'}: {csv}"]
    if hm != "no_output":
        with open(inc_out, "w") as fh:
            fh.write("/NODE\n3000001 0 0 0\n3000002 1 0 0\n/SHELL/1\n3000001 1 3000001 3000002 3000001\n")
        log.append(f"write {inc_out}")
    if hm != "no_marker":
        log.append("COMPLETE HM BATCHRUN")
    with open("log_batch.txt", "w", encoding="utf-8") as fh:
        fh.write("\n".join(log) + "\n")
    print("hw (fake) include written", flush=True)
    sys.exit(3 if hm == "nonzero_with_output" else 0)
a = sys.argv
if "hwpost.dat" in a and "-tcl" in a and a.index("-tcl") + 2 == len(a):  # 원본 ⑤ m_4 응답 추출 TCL(-tcl X가 마지막 인자)
    rm = os.environ.get("FAKE_TOOL_MODE_HWRESP") or m
    folder = os.path.dirname(os.path.abspath(a[a.index("-tcl") + 1]))
    if rm == "fail" or not os.path.isfile(a[a.index("-tcl") + 1]):
        print("hw (fake) response tcl failed", flush=True)
        sys.exit(1)
    reqs = []
    with open(os.path.join(folder, "H3D_REQUESTS.txt"), encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if line and not line.startswith("#"):
                reqs.append(line.split("|"))
    names = sorted(n for n in os.listdir(folder) if n.lower().endswith("_pred.h3d")) or \
        sorted(n for n in os.listdir(folder) if n.lower().endswith(".h3d"))
    extra = (os.path.getsize(os.path.join(folder, names[0])) % 7) if names else 0
    nov = {x for x in (os.environ.get("FAKE_HW_NO_VALUE") or "").split(",") if x}
    out = ["# RESPONSES.txt generated by fake hw"]
    log = [f"h3d: {names}"]
    for i, r in enumerate(reqs):
        name = r[0]
        log.append(f"Request '{name}' : subcase={r[1]} type={r[2]} comp={r[3]} layer={r[4] if len(r) > 4 else ''}")
        if rm == "no_h3d" or not names:
            out.append(f"RESP:{name}=OPEN_ERROR")
        elif name in nov:
            out.append(f"RESP:{name}=NO_VALUE")
        else:
            out.append(f"RESP:{name}_MIN={-(1.5 + i):20.10e}")
            out.append(f"RESP:{name}_MAX={100.0 + 10 * i + extra:20.10e}")
    with open(os.path.join(folder, "RESPONSES.txt"), "w", encoding="utf-8") as fh:
        fh.write("\n".join(out) + "\n")
    with open(os.path.join(folder, "RESPONSES.log"), "w", encoding="utf-8") as fh:
        fh.write("\n".join(log) + "\n")
    print("hw (fake) responses written", flush=True)
    sys.exit(4 if rm == "nonzero_with_output" else 0)
if m == "fail":
    sys.exit(1)
if m == "error_log":  # 종료코드 0 + 오류처럼 보이는 줄(§8.3: edspy step이 아니면 실패로 보지 않아야 함)
    print("Traceback (most recent call last):", flush=True)
    print("[ERROR] fake hw noise", flush=True)
    m = "ok"
a = sys.argv
if "--responses" in a:  # response_extract 템플릿 예시 흉내(§18.1 fake_extract와 같은 동작)
    resp = json.load(open(a[a.index("--responses") + 1], encoding="utf-8"))["responses"]
    with open(a[a.index("--out") + 1], "w", encoding="utf-8") as fh:
        fh.write("name,value\n")
        for i, r in enumerate(resp):
            fh.write(f"{r['name']},{110.0 + i}\n")
    sys.exit(0)
if "-h3d" in a:
    h3d, out = a[a.index("-h3d") + 1], a[a.index("-result") + 1]
    if not os.path.isfile(h3d):
        sys.exit(2)
    if m != "no_output":
        with open(out, "w", encoding="utf-8") as fh:
            json.dump({"datatype_info": {"Stress": ["vonMises", "P1 (major)", "Max Abs Principal"],
                                         "Displacement": ["X", "Y", "Z", "Mag"]},
                       "lst_cid_shell": [1, 2], "lst_cid_solid": [3], "lst_cid_rbody": [], "num_time_step": 5}, fh)
    print("hw (fake) h3d preview", flush=True)
    sys.exit(0)
if "-config" in a:
    cfg = json.load(open(a[a.index("-config") + 1], encoding="utf-8"))
    for i, j in enumerate(cfg["jobs"]):
        if m == "no_output" or (m == "skip_one" and i == 0):
            continue
        if not os.path.isfile(j["inputFile"]):
            continue
        with open(j["outputFile"], "w", encoding="utf-8") as fh:
            json.dump({"series": [{"name": c["yComponent"], "x": [0, 1], "y": [0, 2]} for c in cfg["curves"]]}, fh)
    print("hw (fake) curves", flush=True)
    sys.exit(0)
out = a[a.index("-output") + 1]
inp = a[a.index("-input") + 1]
if not os.path.isfile(inp):
    print(f"input not found {inp}", flush=True)
    sys.exit(2)
if "-c" in a:  # T01 미리보기
    if m != "no_output":
        with open(out, "w", encoding="utf-8") as fh:
            json.dump({"dataTypes": [{"name": "Rigid Body", "requests": [{"name": "RBODY 1", "components": ["F-Mag"]}]}]}, fh)
    print("hw (fake) T01 preview", flush=True)
    sys.exit(0)
with open(out, "w", encoding="utf-8") as fh:
    json.dump({"h3d": inp.replace("\\", "/"), "num_time_step": 5, "subcases": [{"id": 1, "label": "Subcase 1", "datatypes": [
        {"name": "Stress", "format": "tensor", "binding": "element", "components": ["vonMises", "P1 (major)"], "layers": ["Max", "Min"]},
        {"name": "Displacement", "format": "vector", "binding": "node", "components": ["X", "Y", "Z", "Mag"], "layers": []}]}]}, fh)
if os.environ.get("FAKE_HW_IMAGE") == "1":
    png = base64.b64decode("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==")
    with open(os.path.join(os.path.dirname(out), "contour_1.png"), "wb") as fh:
        fh.write(png)
print("hw (fake) preview written", flush=True)
