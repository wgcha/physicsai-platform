#!/usr/bin/env python3
"""가짜 hw.exe(§18.1): -tcl X -input H -output J."""
import base64, json, os, sys

m = os.environ.get("FAKE_TOOL_MODE_HW") or os.environ.get("FAKE_TOOL_MODE") or "ok"
p = os.environ.get("FAKE_TOOL_RECORD")
if p:
    with open(p, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({"tool": "hw", "argv": sys.argv, "cwd": os.getcwd()}) + "\n")
if m == "fail":
    sys.exit(1)
a = sys.argv
if "--responses" in a:  # response_extract 템플릿 예시 흉내(§18.1 fake_extract와 같은 동작)
    resp = json.load(open(a[a.index("--responses") + 1], encoding="utf-8"))["responses"]
    with open(a[a.index("--out") + 1], "w", encoding="utf-8") as fh:
        fh.write("name,value\n")
        for i, r in enumerate(resp):
            fh.write(f"{r['name']},{110.0 + i}\n")
    sys.exit(0)
out = a[a.index("-output") + 1]
inp = a[a.index("-input") + 1]
if not os.path.isfile(inp):
    print(f"input not found {inp}", flush=True)
    sys.exit(2)
with open(out, "w", encoding="utf-8") as fh:
    json.dump({"subcases": [{"name": "Subcase 1", "datatypes": [{"name": "Stress", "components": ["vonMises"]}]}]}, fh)
if os.environ.get("FAKE_HW_IMAGE") == "1":
    png = base64.b64decode("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==")
    with open(os.path.join(os.path.dirname(out), "contour_1.png"), "wb") as fh:
        fh.write(png)
print("hw (fake) preview written", flush=True)
