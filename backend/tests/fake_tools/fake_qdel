#!/usr/bin/env python3
"""가짜 qdel. FAKE_TOOL_MODE_PBS=cancel_fail이면 종료코드 1."""
import json, os, sys

p = os.environ.get("FAKE_TOOL_RECORD")
if p:
    with open(p, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({"tool": "qdel", "argv": sys.argv}) + "\n")
if (os.environ.get("FAKE_TOOL_MODE_PBS") or "") == "cancel_fail":
    print("qdel: Server unreachable", file=sys.stderr)
    sys.exit(1)
