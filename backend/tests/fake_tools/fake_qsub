#!/usr/bin/env python3
"""가짜 qsub: 12345.pbs01 출력, 상태 파일에 기록."""
import json, os, sys, tempfile

m = os.environ.get("FAKE_TOOL_MODE_PBS") or "ok"
state = os.environ.get("FAKE_PBS_STATE") or os.path.join(tempfile.gettempdir(), "fake_pbs_state.json")
p = os.environ.get("FAKE_TOOL_RECORD")
if p:
    with open(p, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({"tool": "qsub", "argv": sys.argv}) + "\n")
if m == "submit_fail":
    print("qsub: Unauthorized Request", file=sys.stderr)
    sys.exit(1)
json.dump({"job": "12345.pbs01", "polls": 0, "argv": sys.argv}, open(state, "w"))
print("12345.pbs01")
